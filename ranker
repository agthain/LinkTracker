<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Rankit</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
:root {
  --gd:#1a3a2a; --gm:#2d5a3d; --gl:#4a8c5c;
  --gmut:#c8dfd0; --gpale:#e8f2eb;
  --ow:#f7f4ee; --oww:#ede8de; --cream:#faf8f3;
  --td:#1a1a16; --tm:#3d3d35; --tmut:#7a7a6e;
  --bord:rgba(26,58,42,0.15); --bordS:rgba(26,58,42,0.3);
  --r:12px; --rs:8px;
  --good:#2d6a4f; --goodbg:#d8f3dc; --goodbord:#95d5b2;
  --mid:#b5630a; --midbg:#fff3cd; --midbord:#ffc107;
  --bad:#9b2226; --badbg:#f8d7da; --badbord:#f5c2c7;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'DM Sans',sans-serif;background:var(--ow);color:var(--td);min-height:100vh;max-width:480px;margin:0 auto}

/* HEADER */
.header{background:var(--gd);padding:20px 20px 16px;position:sticky;top:0;z-index:100}
.header-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.logo{font-family:'DM Serif Display',serif;font-size:26px;color:var(--ow);letter-spacing:-.5px}
.logo span{color:var(--gmut);font-style:italic}
.hbtns{display:flex;gap:8px}
.icon-btn{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.15);color:var(--ow);width:36px;height:36px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:15px;transition:background .15s;flex-shrink:0}
.icon-btn:hover{background:rgba(255,255,255,.2)}
.tabs{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{white-space:nowrap;padding:6px 14px;border-radius:20px;font-size:13px;font-weight:500;cursor:pointer;border:1px solid rgba(255,255,255,.2);color:rgba(255,255,255,.6);background:transparent;transition:all .15s}
.tab.active{background:var(--ow);color:var(--gd);border-color:var(--ow)}

.main{padding:16px 16px 100px}

/* ADD BAR */
.add-bar{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:480px;padding:12px 16px 24px;background:var(--ow);border-top:1px solid var(--bord)}
.add-row{display:flex;gap:8px}
.add-input{flex:1;padding:12px 16px;border:1.5px solid var(--bordS);border-radius:var(--r);background:var(--cream);font-family:'DM Sans',sans-serif;font-size:15px;color:var(--td);outline:none;transition:border-color .15s}
.add-input:focus{border-color:var(--gm)}
.add-input::placeholder{color:var(--tmut)}
.add-btn{padding:12px 16px;background:var(--gd);color:var(--ow);border:none;border-radius:var(--r);font-family:'DM Sans',sans-serif;font-size:15px;font-weight:500;cursor:pointer;white-space:nowrap;transition:background .15s}
.add-btn:hover{background:var(--gm)}
.add-btn.sec{background:transparent;color:var(--gd);border:1.5px solid var(--bordS)}
.add-btn.sec:hover{background:var(--gpale)}

/* VIEW TOGGLE */
.view-toggle{display:flex;gap:0;background:var(--oww);border-radius:20px;padding:3px;margin-bottom:16px}
.vt-btn{flex:1;padding:7px;border:none;background:transparent;border-radius:17px;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:500;color:var(--tmut);cursor:pointer;transition:all .15s}
.vt-btn.active{background:var(--gd);color:var(--ow)}

/* ── TIER SORT PHASE ── */
.tier-phase{display:flex;flex-direction:column;gap:16px}
.tier-item-card{background:var(--cream);border:2px solid var(--bord);border-radius:var(--r);padding:16px;text-align:center}
.tier-item-name{font-family:'DM Serif Display',serif;font-size:22px;color:var(--gd);margin-bottom:4px;word-break:break-word}
.tier-item-sub{font-size:12px;color:var(--tmut);margin-bottom:16px}
.tier-btns{display:flex;gap:8px}
.tier-btn{flex:1;padding:13px 8px;border:2px solid;border-radius:var(--rs);font-family:'DM Sans',sans-serif;font-size:15px;font-weight:600;cursor:pointer;transition:all .15s;-webkit-tap-highlight-color:transparent}
.tier-btn:active{transform:scale(.96)}
.tier-btn.good{background:var(--goodbg);border-color:var(--goodbord);color:var(--good)}
.tier-btn.good:hover{background:#b7e4c7}
.tier-btn.mid{background:var(--midbg);border-color:var(--midbord);color:var(--mid)}
.tier-btn.mid:hover{background:#ffe083}
.tier-btn.bad{background:var(--badbg);border-color:var(--badbord);color:var(--bad)}
.tier-btn.bad:hover{background:#f1b0b7}
.tier-progress-wrap{width:100%}
.tier-progress-label{display:flex;justify-content:space-between;font-size:12px;color:var(--tmut);margin-bottom:6px}
.tier-progress-bar{width:100%;height:6px;background:var(--oww);border-radius:3px;overflow:hidden}
.tier-progress-fill{height:100%;background:var(--gl);border-radius:3px;transition:width .3s ease}
.tier-skip-row{display:flex;justify-content:center}
.tier-skip{padding:8px 20px;background:transparent;border:1.5px solid var(--bord);border-radius:20px;font-family:'DM Sans',sans-serif;font-size:13px;color:var(--tmut);cursor:pointer}
.tier-skip:hover{border-color:var(--bordS);color:var(--tm)}
.tier-done-banner{background:var(--gd);border-radius:var(--r);padding:20px;text-align:center;color:var(--ow)}
.tier-done-banner h3{font-family:'DM Serif Display',serif;font-size:22px;margin-bottom:6px}
.tier-done-banner p{font-size:14px;color:var(--gmut);margin-bottom:16px}
.tier-done-btn{padding:12px 28px;background:var(--ow);color:var(--gd);border:none;border-radius:var(--rs);font-family:'DM Sans',sans-serif;font-size:15px;font-weight:600;cursor:pointer}

/* ── MATCHUP PHASE ── */
.matchup-wrap{display:flex;flex-direction:column;align-items:center;gap:0}
.matchup-context{width:100%;background:var(--cream);border:1px solid var(--bord);border-radius:var(--rs);padding:10px 14px;margin-bottom:14px;display:flex;align-items:center;gap:8px}
.match-type-badge{font-size:11px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;padding:3px 10px;border-radius:10px}
.match-type-badge.border{background:#fff0d6;color:#8a4a00;border:1px solid #ffc107}
.match-type-badge.within{background:var(--gpale);color:var(--gm);border:1px solid var(--gmut)}
.match-context-txt{font-size:13px;color:var(--tmut)}
.prog-row{width:100%;display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.prog-label{font-size:12px;font-weight:600;letter-spacing:.6px;text-transform:uppercase;color:var(--tmut)}
.prog-pct{font-size:12px;color:var(--tmut);font-weight:500}
.matchup-progress{width:100%;background:var(--oww);border-radius:20px;height:6px;margin-bottom:16px;overflow:hidden}
.matchup-progress-fill{height:100%;background:var(--gl);border-radius:20px;transition:width .4s ease}
.matchup-cards{display:flex;gap:12px;width:100%;align-items:stretch}
.matchup-card{flex:1;background:var(--cream);border:2px solid var(--bord);border-radius:16px;padding:18px 12px 14px;display:flex;flex-direction:column;align-items:center;gap:8px;cursor:pointer;transition:all .18s;-webkit-tap-highlight-color:transparent}
.matchup-card:active{transform:scale(.96)}
.matchup-card:hover{border-color:var(--gl);background:var(--gpale)}
.matchup-card.wf{border-color:var(--gd);background:var(--gpale);animation:wf .35s ease}
.matchup-card.lf{opacity:.4;animation:lf .35s ease}
@keyframes wf{0%{transform:scale(1)}40%{transform:scale(1.04)}100%{transform:scale(1)}}
@keyframes lf{0%{opacity:1}100%{opacity:.4}}
.mc-tier-tag{font-size:11px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;padding:3px 10px;border-radius:10px}
.mc-tier-tag.good{background:var(--goodbg);color:var(--good)}
.mc-tier-tag.mid{background:var(--midbg);color:var(--mid)}
.mc-tier-tag.bad{background:var(--badbg);color:var(--bad)}
.mc-name{font-family:'DM Serif Display',serif;font-size:19px;color:var(--gd);text-align:center;line-height:1.3;word-break:break-word}
.mc-elo{font-size:12px;color:var(--tmut);font-weight:500}
.matchup-vs{font-family:'DM Serif Display',serif;font-size:22px;color:var(--tmut);font-style:italic;flex-shrink:0;align-self:center}
.skip-btn{margin-top:10px;padding:9px 22px;background:transparent;color:var(--tmut);border:1.5px solid var(--bord);border-radius:20px;font-family:'DM Sans',sans-serif;font-size:13px;cursor:pointer}
.skip-btn:hover{border-color:var(--bordS);color:var(--tm)}

/* ── RANKINGS ── */
.stats-row{display:flex;gap:8px;margin-bottom:16px}
.stat-pill{flex:1;background:var(--gd);border-radius:var(--rs);padding:10px 12px;text-align:center}
.stat-num{font-family:'DM Serif Display',serif;font-size:22px;color:var(--ow);line-height:1}
.stat-lbl{font-size:11px;color:var(--gmut);margin-top:2px;font-weight:500;letter-spacing:.3px}
.tier-section{margin-bottom:20px}
.tier-header{display:flex;align-items:center;gap:10px;padding:10px 4px 8px}
.tier-header-badge{font-size:12px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;padding:4px 12px;border-radius:10px}
.tier-header-badge.good{background:var(--goodbg);color:var(--good);border:1px solid var(--goodbord)}
.tier-header-badge.mid{background:var(--midbg);color:var(--mid);border:1px solid var(--midbord)}
.tier-header-badge.bad{background:var(--badbg);color:var(--bad);border:1px solid var(--badbord)}
.tier-count{font-size:12px;color:var(--tmut)}
.ranked-list{display:flex;flex-direction:column;gap:6px}
.rank-card{background:var(--cream);border:1px solid var(--bord);border-radius:var(--r);padding:11px 13px;display:flex;align-items:center;gap:11px}
.rank-card.border-match{border-left:3px solid var(--midbord)}
.rank-badge{min-width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0}
.r1{background:#d4af37;color:#5a3e00}
.r2{background:#b0b7bd;color:#2c3035}
.r3{background:#c47a3a;color:#4a2800}
.rN{background:var(--gpale);color:var(--gm)}
.rank-info{flex:1;min-width:0}
.rank-name{font-size:15px;font-weight:500;color:var(--td);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rank-meta{display:flex;align-items:center;gap:8px;margin-top:3px}
.elo-bar-wrap{flex:1;height:4px;background:var(--oww);border-radius:2px;overflow:hidden}
.elo-bar{height:100%;background:var(--gl);border-radius:2px;transition:width .5s}
.rank-elo{font-size:12px;color:var(--gm);font-weight:600;min-width:40px;text-align:right}
.rank-wl{font-size:11px;color:var(--tmut)}
.border-flag{font-size:10px;background:#fff0d6;color:#8a4a00;padding:2px 7px;border-radius:8px;font-weight:600;white-space:nowrap}
.action-btn{width:28px;height:28px;border-radius:50%;border:none;background:transparent;color:var(--tmut);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:13px;transition:all .12s;flex-shrink:0}
.action-btn:hover{background:var(--gpale);color:var(--gd)}
.action-btn.del:hover{background:#fde8e8;color:#c0392b}
.fight-banner{background:var(--gd);border-radius:var(--r);padding:14px 16px;display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;cursor:pointer;transition:background .15s}
.fight-banner:hover{background:var(--gm)}
.fight-banner-txt{color:var(--ow);font-size:15px;font-weight:500}
.fight-banner-sub{color:var(--gmut);font-size:12px;margin-top:2px}
.fight-banner-arrow{color:var(--ow);font-size:22px}
.unranked-badge{display:inline-block;font-size:10px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;color:var(--tmut);background:var(--oww);padding:2px 8px;border-radius:10px;margin-top:3px}

/* MODALS */
.modal-overlay{position:fixed;inset:0;background:rgba(10,20,14,.55);display:flex;align-items:flex-end;justify-content:center;z-index:200}
.modal{background:var(--cream);width:100%;max-width:480px;border-radius:var(--r) var(--r) 0 0;padding:20px 20px 36px;animation:slideUp .22s ease}
@keyframes slideUp{from{transform:translateY(30px);opacity:0}to{transform:translateY(0);opacity:1}}
.modal-handle{width:36px;height:4px;background:var(--bordS);border-radius:2px;margin:0 auto 16px}
.modal-title{font-family:'DM Serif Display',serif;font-size:20px;color:var(--gd);margin-bottom:16px}
.modal-field{margin-bottom:14px}
.modal-label{font-size:12px;font-weight:600;letter-spacing:.5px;color:var(--tmut);margin-bottom:6px;text-transform:uppercase}
.modal-input{width:100%;padding:11px 14px;border:1.5px solid var(--bordS);border-radius:var(--rs);background:var(--ow);font-family:'DM Sans',sans-serif;font-size:15px;color:var(--td);outline:none;transition:border-color .15s}
.modal-input:focus{border-color:var(--gm)}
.modal-actions{display:flex;gap:8px;margin-top:20px}
.btn-primary{flex:1;padding:13px;background:var(--gd);color:var(--ow);border:none;border-radius:var(--rs);font-family:'DM Sans',sans-serif;font-size:15px;font-weight:500;cursor:pointer;transition:background .15s}
.btn-primary:hover{background:var(--gm)}
.btn-ghost{padding:13px 18px;background:transparent;color:var(--tmut);border:1.5px solid var(--bord);border-radius:var(--rs);font-family:'DM Sans',sans-serif;font-size:15px;cursor:pointer}
.bulk-area{width:100%;height:120px;padding:12px 14px;border:1.5px solid var(--bordS);border-radius:var(--rs);background:var(--ow);font-family:'DM Sans',sans-serif;font-size:14px;color:var(--td);outline:none;resize:none;line-height:1.6}
.bulk-area:focus{border-color:var(--gm)}
.bulk-hint{font-size:12px;color:var(--tmut);margin-top:6px;line-height:1.5}
.file-upload-area{border:2px dashed var(--bordS);border-radius:var(--rs);padding:20px;text-align:center;cursor:pointer;transition:all .15s}
.file-upload-area:hover{border-color:var(--gm);background:var(--gpale)}
.file-upload-area input{display:none}
.upload-icon{font-size:28px;margin-bottom:6px;color:var(--gm)}
.upload-text{font-size:14px;color:var(--tm)}
.upload-sub{font-size:12px;color:var(--tmut);margin-top:3px}
.empty-state{text-align:center;padding:60px 24px}
.empty-icon{font-size:48px;margin-bottom:16px;opacity:.4}
.empty-state h3{font-family:'DM Serif Display',serif;font-size:22px;color:var(--gd);margin-bottom:8px}
.empty-state p{font-size:14px;color:var(--tmut);line-height:1.6;margin-bottom:24px}
.toast{position:fixed;bottom:100px;left:50%;transform:translateX(-50%);background:var(--gd);color:var(--ow);padding:10px 20px;border-radius:20px;font-size:14px;font-weight:500;z-index:300;animation:tIn .2s ease,tOut .2s ease 1.6s forwards;pointer-events:none;white-space:nowrap}
@keyframes tIn{from{opacity:0;transform:translateX(-50%) translateY(10px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}
@keyframes tOut{from{opacity:1}to{opacity:0}}
</style>
</head>
<body>

<div class="header">
  <div class="header-top">
    <div class="logo">rank<span>it.</span></div>
    <div class="hbtns">
      <button class="icon-btn" title="Import Excel" onclick="openImport()">↑</button>
      <button class="icon-btn" title="Export Excel" onclick="exportExcel()">↓</button>
      <button class="icon-btn" title="New list" onclick="openNewList()">+</button>
    </div>
  </div>
  <div class="tabs" id="tabBar"></div>
</div>

<div class="main" id="mainContent"></div>

<div class="add-bar">
  <div class="add-row">
    <input class="add-input" id="addInput" placeholder="Add an item…" onkeydown="if(event.key==='Enter')quickAdd()">
    <button class="add-btn sec" onclick="openBulk()">Bulk</button>
    <button class="add-btn" onclick="quickAdd()">Add</button>
  </div>
</div>

<!-- New List -->
<div class="modal-overlay" id="newListModal" style="display:none" onclick="if(event.target===this)closeNewList()">
  <div class="modal">
    <div class="modal-handle"></div>
    <div class="modal-title">New list</div>
    <div class="modal-field">
      <div class="modal-label">List name</div>
      <input class="modal-input" id="newListName" placeholder="e.g. Ramen spots, Albums, Films…" onkeydown="if(event.key==='Enter')confirmNewList()">
    </div>
    <div class="modal-actions">
      <button class="btn-ghost" onclick="closeNewList()">Cancel</button>
      <button class="btn-primary" onclick="confirmNewList()">Create</button>
    </div>
  </div>
</div>

<!-- Bulk -->
<div class="modal-overlay" id="bulkModal" style="display:none" onclick="if(event.target===this)closeBulk()">
  <div class="modal">
    <div class="modal-handle"></div>
    <div class="modal-title">Bulk add items</div>
    <div class="modal-field">
      <textarea class="bulk-area" id="bulkText" placeholder="One item per line…"></textarea>
      <div class="bulk-hint">Each line = one item. Duplicates skipped.</div>
    </div>
    <div class="modal-actions">
      <button class="btn-ghost" onclick="closeBulk()">Cancel</button>
      <button class="btn-primary" onclick="confirmBulk()">Add items</button>
    </div>
  </div>
</div>

<!-- Import -->
<div class="modal-overlay" id="importModal" style="display:none" onclick="if(event.target===this)closeImport()">
  <div class="modal">
    <div class="modal-handle"></div>
    <div class="modal-title">Import from Excel</div>
    <div class="file-upload-area" onclick="document.getElementById('fileInput').click()">
      <input type="file" id="fileInput" accept=".xlsx,.xls" onchange="handleImport(event)">
      <div class="upload-icon">📊</div>
      <div class="upload-text">Tap to choose an Excel file</div>
      <div class="upload-sub">Column A = Item name · Column B = Tier (Good/Mid/Bad) · Column C = ELO</div>
    </div>
    <div class="modal-actions" style="margin-top:16px">
      <button class="btn-ghost" onclick="closeImport()">Cancel</button>
    </div>
  </div>
</div>

<script>
// ── CONSTANTS ─────────────────────────────────────────────────────
const K = 32;
const BASE_ELO = { good: 1200, mid: 1000, bad: 800 };
const TIERS = ['good','mid','bad'];

// ── STATE ─────────────────────────────────────────────────────────
let state = { lists: [], activeList: null };
let view = 'tier';   // 'tier' | 'matchup' | 'rankings'
let animating = false;
let currentMatchup = null;

function uid() { return Math.random().toString(36).slice(2,9); }
function save() { try { localStorage.setItem('rankit_v3', JSON.stringify(state)); } catch(e){} }
function load() {
  try { const r = localStorage.getItem('rankit_v3'); if (r) state = JSON.parse(r); } catch(e){}
  if (!state.lists?.length) state.lists = [{ id: uid(), name: 'My List', items: [] }];
  state.activeList = state.activeList || state.lists[0].id;
}
function activeList() { return state.lists.find(l => l.id === state.activeList); }

// ── ELO ──────────────────────────────────────────────────────────
function expectedScore(rA, rB) { return 1 / (1 + Math.pow(10, (rB - rA) / 400)); }
function applyElo(winner, loser) {
  const eW = expectedScore(winner.elo, loser.elo);
  const eL = expectedScore(loser.elo, winner.elo);
  winner.elo = Math.round(winner.elo + K * (1 - eW));
  loser.elo  = Math.round(loser.elo  + K * (0 - eL));
  winner.wins    = (winner.wins   || 0) + 1;
  loser.losses   = (loser.losses  || 0) + 1;
  winner.matchups = (winner.matchups || 0) + 1;
  loser.matchups  = (loser.matchups  || 0) + 1;
}

// ── MATCHUP SELECTION (50/50 border vs within-tier) ───────────────
// Returns {pair:[a,b], type:'border'|'within', label:string}
function pickMatchup(items) {
  if (items.length < 2) return null;

  const byTier = {};
  TIERS.forEach(t => {
    byTier[t] = items.filter(i => i.tier === t).sort((a,b) => b.elo - a.elo);
  });

  // Border pairs: worst of upper tier vs best of lower tier
  const borderPairs = [];
  const tierPairs = [['good','mid'],['mid','bad']];
  tierPairs.forEach(([upper, lower]) => {
    const upList = byTier[upper], loList = byTier[lower];
    if (upList.length && loList.length) {
      // Worst of upper = last; best of lower = first
      borderPairs.push({
        pair: [upList[upList.length-1], loList[0]],
        type: 'border',
        label: `${cap(upper)} / ${cap(lower)} border`
      });
    }
  });

  // Within-tier pairs: pick least-battled close-ELO pair per tier
  const withinPairs = [];
  TIERS.forEach(t => {
    const list = byTier[t];
    if (list.length < 2) return;
    let best = null, bestScore = Infinity;
    const sample = [...list].sort(() => Math.random() - .5).slice(0, 15);
    for (let i = 0; i < sample.length; i++) {
      for (let j = i+1; j < sample.length; j++) {
        const a = sample[i], b = sample[j];
        const s = ((a.matchups||0)+(b.matchups||0)) * 150 + Math.abs(a.elo - b.elo);
        if (s < bestScore) { bestScore = s; best = { pair:[a,b], type:'within', label:`Within ${cap(t)}` }; }
      }
    }
    if (best) withinPairs.push(best);
  });

  // Combine available pools
  const pool = [];
  borderPairs.forEach(p => pool.push({ ...p, weight: 1 }));   // each border = 1 slot
  withinPairs.forEach(p => pool.push({ ...p, weight: 1 }));   // each within = 1 slot
  // 50/50 between border total and within total by normalising weights
  // Simple: flip coin to pick category, then random within category
  const useBorder = borderPairs.length > 0 && (withinPairs.length === 0 || Math.random() < 0.5);
  const chosen = useBorder
    ? borderPairs[Math.floor(Math.random() * borderPairs.length)]
    : withinPairs.length > 0 ? withinPairs[Math.floor(Math.random() * withinPairs.length)] : borderPairs[0];

  if (!chosen) return null;
  // Randomise left/right
  if (Math.random() < 0.5) chosen.pair = [chosen.pair[1], chosen.pair[0]];
  return chosen;
}

function cap(s) { return s.charAt(0).toUpperCase() + s.slice(1); }

// ── UNSORTED ITEMS (need tier assignment) ────────────────────────
function untieredItems(list) { return list.items.filter(i => !i.tier); }
function tieredItems(list)   { return list.items.filter(i => !!i.tier); }

// ── RENDER ────────────────────────────────────────────────────────
function render() { renderTabs(); renderMain(); }
function renderTabs() {
  document.getElementById('tabBar').innerHTML =
    state.lists.map(l =>
      `<button class="tab${l.id===state.activeList?' active':''}" onclick="switchList('${l.id}')">${l.name}</button>`
    ).join('') +
    `<button class="tab" style="border-style:dashed;color:rgba(255,255,255,.4)" onclick="openNewList()">+ New</button>`;
}

function renderMain() {
  const list = activeList();
  const el = document.getElementById('mainContent');
  if (!list || !list.items.length) {
    el.innerHTML = `<div class="empty-state">
      <div class="empty-icon">🏆</div>
      <h3>Nothing to rank yet</h3>
      <p>Add items below one at a time or paste a list with Bulk. You'll sort each into Good, Mid, or Bad — then battles begin.</p>
    </div>`; return;
  }

  const untiered = untieredItems(list);
  const tiered   = tieredItems(list);

  // Decide which view to show
  if (view === 'tier' && untiered.length > 0) {
    el.innerHTML = renderTierPhase(list, untiered, tiered);
    return;
  }
  if (untiered.length === 0 && tiered.length >= 2 && view === 'tier') {
    view = 'matchup';
  }

  const hasEnoughForBattles = tiered.length >= 2;

  let html = '';
  if (hasEnoughForBattles) {
    html += `<div class="view-toggle">
      <button class="vt-btn${view==='matchup'?' active':''}" onclick="setView('matchup')">⚔️ Matchup</button>
      <button class="vt-btn${view==='rankings'?' active':''}" onclick="setView('rankings')">🏆 Rankings</button>
    </div>`;
  }

  if (untiered.length > 0) {
    html += `<div style="background:var(--midbg);border:1px solid var(--midbord);border-radius:var(--rs);padding:12px 14px;margin-bottom:14px;display:flex;align-items:center;justify-content:space-between">
      <div>
        <div style="font-size:14px;font-weight:600;color:var(--mid)">${untiered.length} item${untiered.length!==1?'s':''} need sorting</div>
        <div style="font-size:12px;color:var(--mid);opacity:.8;margin-top:2px">Sort them into tiers first</div>
      </div>
      <button onclick="setView('tier')" style="padding:8px 14px;background:var(--mid);color:#fff;border:none;border-radius:var(--rs);font-family:'DM Sans',sans-serif;font-size:13px;font-weight:600;cursor:pointer">Sort now</button>
    </div>`;
  }

  if (view === 'matchup' && hasEnoughForBattles) {
    html += renderMatchupView(list, tiered);
  } else if (view === 'rankings' || !hasEnoughForBattles) {
    html += renderRankingsView(list, tiered, untiered);
  }
  el.innerHTML = html;
  if (view === 'matchup') attachMatchupListeners();
}

// ── TIER SORT PHASE ───────────────────────────────────────────────
function renderTierPhase(list, untiered, tiered) {
  const total = list.items.length;
  const done  = tiered.length;
  const pct   = Math.round(done / total * 100);
  const item  = untiered[0];

  return `<div class="tier-phase">
    <div class="tier-progress-wrap">
      <div class="tier-progress-label">
        <span>Sorting into tiers</span>
        <span>${done} / ${total}</span>
      </div>
      <div class="tier-progress-bar"><div class="tier-progress-fill" style="width:${pct}%"></div></div>
    </div>
    <div class="tier-item-card">
      <div class="tier-item-name">${item.name}</div>
      <div class="tier-item-sub">Where does this land?</div>
      <div class="tier-btns">
        <button class="tier-btn good" onclick="assignTier('${item.id}','good')">👍 Good</button>
        <button class="tier-btn mid"  onclick="assignTier('${item.id}','mid')">😐 Mid</button>
        <button class="tier-btn bad"  onclick="assignTier('${item.id}','bad')">👎 Bad</button>
      </div>
    </div>
    ${untiered.length === 1 ? '' : `<div class="tier-skip-row"><button class="tier-skip" onclick="skipTier('${item.id}')">Sort later</button></div>`}
    ${done > 0 ? `<button onclick="setView('matchup')" style="padding:10px;background:transparent;border:1.5px solid var(--bordS);border-radius:var(--rs);font-family:'DM Sans',sans-serif;font-size:13px;color:var(--tmut);cursor:pointer;width:100%">Skip to battles with ${done} sorted item${done!==1?'s':''} →</button>` : ''}
  </div>`;
}

function assignTier(id, tier) {
  const list = activeList();
  const item = list.items.find(i => i.id === id);
  if (!item) return;
  item.tier = tier;
  item.elo  = BASE_ELO[tier];
  item.wins = 0; item.losses = 0; item.matchups = 0;
  save();
  const remaining = untieredItems(list);
  if (remaining.length === 0) {
    view = 'matchup';
  }
  render();
}

function skipTier(id) {
  const list = activeList();
  const item = list.items.find(i => i.id === id);
  if (!item) return;
  // Move to end so it comes up again later
  list.items = list.items.filter(i => i.id !== id);
  list.items.push(item);
  save(); render();
}

// ── MATCHUP VIEW ──────────────────────────────────────────────────
function renderMatchupView(list, tiered) {
  currentMatchup = pickMatchup(tiered);
  if (!currentMatchup) return '<div class="empty-state"><div class="empty-icon">⚔️</div><h3>No battles available</h3><p>Add more items to different tiers.</p></div>';

  const [a, b] = currentMatchup.pair;
  const totalM  = tiered.reduce((s,i) => s + (i.matchups||0), 0);
  const n       = tiered.length;
  const target  = Math.max(n * Math.ceil(Math.log2(n + 1)), 10);
  const pct     = Math.min(100, Math.round(totalM / target * 100));
  const isBorder = currentMatchup.type === 'border';

  return `<div class="matchup-wrap">
    <div class="matchup-context">
      <span class="match-type-badge ${isBorder ? 'border' : 'within'}">${isBorder ? '🔀 Border' : '⚔️ Within'}</span>
      <span class="match-context-txt">${currentMatchup.label}</span>
    </div>
    <div class="prog-row">
      <span class="prog-label">Which is better?</span>
      <span class="prog-pct">${pct}% settled</span>
    </div>
    <div class="matchup-progress"><div class="matchup-progress-fill" style="width:${pct}%"></div></div>
    <div class="matchup-cards">
      <div class="matchup-card" id="mc-a" data-id="${a.id}">
        <span class="mc-tier-tag ${a.tier}">${cap(a.tier)}</span>
        <div class="mc-name">${a.name}</div>
        <div class="mc-elo">${a.elo} pts · ${a.wins||0}W ${a.losses||0}L</div>
      </div>
      <div class="matchup-vs">vs</div>
      <div class="matchup-card" id="mc-b" data-id="${b.id}">
        <span class="mc-tier-tag ${b.tier}">${cap(b.tier)}</span>
        <div class="mc-name">${b.name}</div>
        <div class="mc-elo">${b.elo} pts · ${b.wins||0}W ${b.losses||0}L</div>
      </div>
    </div>
    <button class="skip-btn" onclick="skipMatchup()">Skip this matchup</button>
  </div>`;
}

function attachMatchupListeners() {
  const ca = document.getElementById('mc-a');
  const cb = document.getElementById('mc-b');
  if (ca) ca.addEventListener('click', () => handlePick(ca, cb));
  if (cb) cb.addEventListener('click', () => handlePick(cb, ca));
}

function handlePick(wEl, lEl) {
  if (animating) return;
  animating = true;
  const list   = activeList();
  const winner = list.items.find(i => i.id === wEl.dataset.id);
  const loser  = list.items.find(i => i.id === lEl.dataset.id);
  if (!winner || !loser) { animating = false; return; }
  wEl.classList.add('wf'); lEl.classList.add('lf');
  applyElo(winner, loser);

  // Re-tier: if border match winner, consider promoting/demoting
  // (ELO naturally separates them; tier boundaries shift via explicit re-sort button in future)
  save();
  setTimeout(() => { animating = false; renderMain(); }, 360);
}

function skipMatchup() { if (!animating) renderMain(); }

// ── RANKINGS VIEW ─────────────────────────────────────────────────
function renderRankingsView(list, tiered, untiered) {
  const totalM = tiered.reduce((s,i) => s + (i.matchups||0), 0) / 2;

  let html = `<div class="stats-row">
    <div class="stat-pill"><div class="stat-num">${list.items.length}</div><div class="stat-lbl">Items</div></div>
    <div class="stat-pill"><div class="stat-num">${Math.round(totalM)}</div><div class="stat-lbl">Battles</div></div>
    <div class="stat-pill"><div class="stat-num">${tiered.length}</div><div class="stat-lbl">Ranked</div></div>
  </div>`;

  if (tiered.length >= 2) {
    html += `<div class="fight-banner" onclick="setView('matchup')">
      <div><div class="fight-banner-txt">⚔️ Keep battling</div><div class="fight-banner-sub">Rankings sharpen with more matchups</div></div>
      <div class="fight-banner-arrow">›</div>
    </div>`;
  }

  // Render each tier with overall rank numbers
  const allSorted = getSortedTiered(tiered);

  TIERS.forEach(tier => {
    const items = allSorted.filter(i => i.tier === tier);
    if (!items.length) return;

    const maxElo = Math.max(...items.map(i => i.elo));
    const minElo = Math.min(...items.map(i => i.elo));
    const range  = maxElo - minElo || 1;

    html += `<div class="tier-section">
      <div class="tier-header">
        <span class="tier-header-badge ${tier}">${cap(tier)}</span>
        <span class="tier-count">${items.length} item${items.length!==1?'s':''}</span>
      </div>
      <div class="ranked-list">`;

    items.forEach((item, idx) => {
      const overallRank = allSorted.indexOf(item) + 1;
      const bClass = overallRank===1?'r1':overallRank===2?'r2':overallRank===3?'r3':'rN';
      const barPct = Math.round((item.elo - minElo) / range * 100);
      const wr = item.matchups ? Math.round((item.wins||0)/item.matchups*100) : 0;

      // Flag border items: worst of good, best/worst of mid, best of bad
      const tierItems = items;
      const isBorderItem = (tier==='good' && idx===tierItems.length-1) ||
                           (tier==='mid'  && (idx===0 || idx===tierItems.length-1)) ||
                           (tier==='bad'  && idx===0);

      html += `<div class="rank-card${isBorderItem?' border-match':''}">
        <div class="rank-badge ${bClass}">${overallRank}</div>
        <div class="rank-info">
          <div class="rank-name">${item.name}</div>
          <div class="rank-meta">
            <div class="elo-bar-wrap"><div class="elo-bar" style="width:${barPct}%"></div></div>
            <span class="rank-elo">${item.elo}</span>
          </div>
          <div style="display:flex;align-items:center;gap:8px">
            <span class="rank-wl">${item.wins||0}W · ${item.losses||0}L · ${wr}% wr</span>
            ${isBorderItem ? `<span class="border-flag">border</span>` : ''}
          </div>
        </div>
        <button class="action-btn" onclick="reTier('${item.id}')" title="Change tier">↕</button>
        <button class="action-btn del" onclick="deleteItem('${item.id}')" title="Remove">✕</button>
      </div>`;
    });
    html += `</div></div>`;
  });

  if (untiered.length) {
    html += `<div class="tier-section">
      <div class="tier-header"><span class="tier-header-badge" style="background:var(--oww);color:var(--tmut);border:1px solid var(--bord)">Unsorted</span></div>
      <div class="ranked-list">`;
    untiered.forEach(item => {
      html += `<div class="rank-card">
        <div class="rank-badge rN" style="font-size:18px">?</div>
        <div class="rank-info">
          <div class="rank-name">${item.name}</div>
          <span class="unranked-badge">Needs tier</span>
        </div>
        <button class="action-btn" onclick="setView('tier')" title="Sort now">→</button>
        <button class="action-btn del" onclick="deleteItem('${item.id}')" title="Remove">✕</button>
      </div>`;
    });
    html += `</div></div>`;
  }
  return html;
}

function getSortedTiered(items) {
  // Sort: Good first, then Mid, then Bad; within each tier by ELO desc
  const order = { good: 0, mid: 1, bad: 2 };
  return [...items].sort((a, b) => {
    if (order[a.tier] !== order[b.tier]) return order[a.tier] - order[b.tier];
    return b.elo - a.elo;
  });
}

// ── RE-TIER ───────────────────────────────────────────────────────
function reTier(id) {
  const list = activeList();
  const item = list.items.find(i => i.id === id);
  if (!item) return;
  // Show quick picker — inline approach
  const tier = item.tier;
  const opts = TIERS.filter(t => t !== tier);
  const choice = window.confirm(
    `Move "${item.name}" out of ${cap(tier)}?\n\nOK = move to next tier down / up\nCancel = keep as is`
  );
  if (!choice) return;
  // Cycle through tiers
  const idx = TIERS.indexOf(tier);
  item.tier = TIERS[(idx + 1) % TIERS.length];
  item.elo  = BASE_ELO[item.tier];
  save(); render();
}

// ── UI CONTROLS ───────────────────────────────────────────────────
function setView(v) { view = v; renderMain(); }
function switchList(id) { state.activeList = id; save(); view = 'tier'; render(); }

function quickAdd() {
  const input = document.getElementById('addInput');
  const val = input.value.trim(); if (!val) return;
  const list = activeList();
  if (list.items.find(i => i.name.toLowerCase() === val.toLowerCase())) { showToast('Already on the list!'); return; }
  list.items.push({ id: uid(), name: val });
  input.value = '';
  if (view !== 'tier') view = 'tier';
  save(); render();
}

function deleteItem(id) {
  const list = activeList();
  list.items = list.items.filter(i => i.id !== id);
  save(); render();
}

function openNewList() { document.getElementById('newListName').value=''; document.getElementById('newListModal').style.display='flex'; setTimeout(()=>document.getElementById('newListName').focus(),100); }
function closeNewList() { document.getElementById('newListModal').style.display='none'; }
function confirmNewList() {
  const name = document.getElementById('newListName').value.trim(); if (!name) return;
  const nl = { id: uid(), name, items: [] };
  state.lists.push(nl); state.activeList = nl.id;
  closeNewList(); save(); view='tier'; render();
}

function openBulk() { document.getElementById('bulkText').value=''; document.getElementById('bulkModal').style.display='flex'; setTimeout(()=>document.getElementById('bulkText').focus(),100); }
function closeBulk() { document.getElementById('bulkModal').style.display='none'; }
function confirmBulk() {
  const lines = document.getElementById('bulkText').value.split('\n').map(l=>l.trim()).filter(Boolean);
  const list = activeList(); let added = 0;
  lines.forEach(name => {
    if (!list.items.find(i => i.name.toLowerCase()===name.toLowerCase())) {
      list.items.push({ id: uid(), name });
      added++;
    }
  });
  closeBulk(); save(); view='tier'; render();
  showToast(`Added ${added} item${added!==1?'s':''}`);
}

// ── EXCEL EXPORT ──────────────────────────────────────────────────
function exportExcel() {
  const list = activeList();
  const sorted = getSortedTiered(tieredItems(list));
  const untiered = untieredItems(list);

  const rows = [['Rank','Item','Tier','ELO','Wins','Losses','Win Rate','Matchups']];
  sorted.forEach((item, idx) => {
    const wr = item.matchups ? ((item.wins||0)/item.matchups*100).toFixed(1)+'%' : '—';
    rows.push([idx+1, item.name, cap(item.tier), item.elo, item.wins||0, item.losses||0, wr, item.matchups||0]);
  });
  untiered.forEach(item => {
    rows.push(['—', item.name, 'Unsorted', '—', '—', '—', '—', '—']);
  });

  const wb = XLSX.utils.book_new();
  const ws = XLSX.utils.aoa_to_sheet(rows);

  // Column widths
  ws['!cols'] = [
    {wch:6},{wch:30},{wch:10},{wch:8},{wch:6},{wch:8},{wch:10},{wch:10}
  ];

  XLSX.utils.book_append_sheet(wb, ws, list.name.slice(0,31));
  XLSX.writeFile(wb, `${list.name.replace(/\s+/g,'_')}_rankit.xlsx`);
  showToast('Exported to Excel!');
}

// ── EXCEL IMPORT ──────────────────────────────────────────────────
function openImport() { document.getElementById('importModal').style.display='flex'; }
function closeImport() { document.getElementById('importModal').style.display='none'; }

function handleImport(e) {
  const file = e.target.files[0]; if (!file) return;
  const reader = new FileReader();
  reader.onload = ev => {
    try {
      const wb = XLSX.read(ev.target.result, { type: 'binary' });
      const ws = wb.Sheets[wb.SheetNames[0]];
      const rows = XLSX.utils.sheet_to_json(ws, { header:1, defval:'' });
      // Skip header row
      const dataRows = rows.slice(1).filter(r => r[1]);
      if (!dataRows.length) { showToast('No data found'); return; }

      const listName = wb.SheetNames[0] || 'Imported List';
      const items = dataRows.map(r => {
        const name   = String(r[1]).trim();
        const tier   = TIERS.includes(String(r[2]).toLowerCase()) ? String(r[2]).toLowerCase() : null;
        const elo    = parseInt(r[3]) || (tier ? BASE_ELO[tier] : undefined);
        const wins   = parseInt(r[4]) || 0;
        const losses = parseInt(r[5]) || 0;
        const matchups = parseInt(r[7]) || 0;
        const item = { id: uid(), name };
        if (tier) { item.tier = tier; item.elo = elo; item.wins = wins; item.losses = losses; item.matchups = matchups; }
        return item;
      }).filter(i => i.name);

      const nl = { id: uid(), name: listName, items };
      state.lists.push(nl); state.activeList = nl.id;
      save(); view = 'tier'; render(); closeImport();
      showToast(`"${listName}" imported — ${items.length} items`);
    } catch(err) { showToast('Could not read file'); console.error(err); }
  };
  reader.readAsBinaryString(file);
  e.target.value = '';
}

// ── TOAST ─────────────────────────────────────────────────────────
let toastTimer;
function showToast(msg) {
  document.querySelector('.toast')?.remove(); clearTimeout(toastTimer);
  const t = document.createElement('div'); t.className='toast'; t.textContent=msg;
  document.body.appendChild(t);
  toastTimer = setTimeout(()=>t.remove(), 1900);
}

load(); render();
</script>
